import cv2
import socket
import struct
import numpy as np
from ultralytics import YOLO

HOST = '0.0.0.0'
PORT = 5000

print("Loading YOLO11 Models on GX10 GPU (FP16 Mode)...")
model_pose = YOLO("yolo11n-pose.pt") 
model_obj = YOLO("yolo11x.pt")       

def recvall(sock, count):
    buf = b''
    while count > 0:
        newbuf = sock.recv(count)
        if not newbuf: return None
        buf += newbuf
        count -= len(newbuf)
    return buf

print(f"GX10 Server Online. Listening on Port {PORT}...")

server_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
server_socket.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1) 
server_socket.bind((HOST, PORT))
server_socket.listen(1)

while True:
    print("\nWaiting for Laptop to connect...")
    conn, addr = server_socket.accept()
    print(f"Laptop Connected from: {addr}")

    try:
        while True:
            header = recvall(conn, 20)
            if not header: break 

            target_class_raw = header[:16].decode('utf-8').strip('\x00')
            frame_size = struct.unpack('<I', header[16:20])[0]

            frame_data = recvall(conn, frame_size)
            if not frame_data: break

            np_arr = np.frombuffer(frame_data, np.uint8)
            frame = cv2.imdecode(np_arr, cv2.IMREAD_COLOR)

            h, w = frame.shape[:2]
            tx, ty, found = w // 2, h // 2, 0 
            boxes_data = "" 

            target_list = [t.strip() for t in target_class_raw.split(',')]
            is_pose_mode = "person" in target_list

            if is_pose_mode:
                results = model_pose.predict(frame, verbose=False, conf=0.45, half=True)
                if results and results[0].keypoints:
                    kps = results[0].keypoints.xy.cpu().numpy()
                    confs = results[0].keypoints.conf.cpu().numpy() if results[0].keypoints.conf is not None else [0.9] * len(kps)
                    for i, person in enumerate(kps):
                        if len(person) > 0 and person[0][0] > 0:
                            tx, ty = int(person[0][0]), int(person[0][1])
                            found = 1

                            conf = confs[i][0] if hasattr(confs[i], "__len__") else 0.9
                            boxes_data += f"person,{tx-50},{ty-50},{tx+50},{ty+50},{conf:.2f};"
                            break
            else:
                results = model_obj.predict(frame, verbose=False, conf=0.45, half=True)
                if results and results[0].boxes:
                    for box in results[0].boxes:
                        cls_id = int(box.cls[0])
                        cls_name = model_obj.names[cls_id]
                        conf = float(box.conf[0])
                        x1, y1, x2, y2 = box.xyxy[0].cpu().numpy()

                        boxes_data += f"{cls_name},{int(x1)},{int(y1)},{int(x2)},{int(y2)},{conf:.2f};"

                        if cls_name in target_list and not found:
                            tx = int((x1 + x2) / 2)
                            ty = int((y1 + y2) / 2)
                            found = 1

            reply = f"{tx},{ty},{found}|{boxes_data}\n"
            conn.sendall(reply.encode('utf-8'))

    except Exception as e:
        print(f"\nConnection error: {e}")
    finally:
        conn.close()
