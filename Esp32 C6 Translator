#include <Arduino.h>

#define YAW_STEP 21
#define YAW_DIR 22

#define PITCH_STEP 23
#define PITCH_DIR 15

unsigned long lastMicrosX = 0;
unsigned long lastMicrosY = 0;

int targetStepsX = 0;
int targetStepsY = 0;

bool stepStateX = LOW;
bool stepStateY = LOW;

int stepDelay = 300; 

void setup() {
  Serial.begin(921600);

  pinMode(YAW_STEP, OUTPUT);
  pinMode(YAW_DIR, OUTPUT);
  pinMode(PITCH_STEP, OUTPUT);
  pinMode(PITCH_DIR, OUTPUT);

  digitalWrite(YAW_STEP, LOW);
  digitalWrite(PITCH_STEP, LOW);
}

void loop() {

  if (Serial.available() > 0) {
    String data = Serial.readStringUntil('\n');

    int comma1 = data.indexOf(',');
    int comma2 = data.indexOf(',', comma1 + 1);
    int comma3 = data.indexOf(',', comma2 + 1);

    if (comma1 != -1 && comma2 != -1 && comma3 != -1) {
      int dirX = data.substring(0, comma1).toInt();
      int incomingStepsX = data.substring(comma1 + 1, comma2).toInt();

      int dirY = data.substring(comma2 + 1, comma3).toInt();
      int incomingStepsY = data.substring(comma3 + 1).toInt();

      digitalWrite(YAW_DIR, (dirX == 1) ? HIGH : LOW);
      digitalWrite(PITCH_DIR, (dirY == 1) ? HIGH : LOW);

      targetStepsX = incomingStepsX;
      targetStepsY = incomingStepsY;
    }
  }

  unsigned long currentMicros = micros();

  if (targetStepsX > 0) {
    if (currentMicros - lastMicrosX >= stepDelay) {
      lastMicrosX = currentMicros;
      stepStateX = !stepStateX;
      digitalWrite(YAW_STEP, stepStateX);

      if (stepStateX == LOW) {
        targetStepsX--;
      }
    }
  }

  if (targetStepsY > 0) {
    if (currentMicros - lastMicrosY >= stepDelay) {
      lastMicrosY = currentMicros;
      stepStateY = !stepStateY;
      digitalWrite(PITCH_STEP, stepStateY);

      if (stepStateY == LOW) {
        targetStepsY--;
      }
    }
  }
}
